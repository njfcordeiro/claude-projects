DATABASE_URL="postgresql://gapapp:CHANGE_ME@localhost:5432/gap_analysis?schema=public"

# Caminho para o ficheiro Excel de origem, usado pelo script de importação
EXCEL_SOURCE_PATH="../docs/source-data/Tabelas_criacao_programa.xlsx"

# --- API (NestJS) ---
PORT=3000
FRONTEND_ORIGIN="http://localhost:5173"

# Gera um valor forte, ex.: `openssl rand -base64 48`. Nunca commitar o valor real.
JWT_SECRET="CHANGE_ME"
JWT_EXPIRES_IN="8h"

# --- npm run seed:admin (cria o primeiro utilizador ADMIN_RH) ---
ADMIN_EMAIL="admin@empresa.pt"
ADMIN_PASSWORD="CHANGE_ME_min_8_chars"
