# Usado pelo docker-compose.yml (dev local). Copia para .env na raiz do
# projeto e ajusta antes de correr `docker compose up`.

POSTGRES_USER=gapapp
POSTGRES_PASSWORD=gapapp_dev_pw
POSTGRES_DB=gap_analysis

# Gera um valor forte, ex.: `openssl rand -base64 48`. Nunca commitar o valor real.
JWT_SECRET=CHANGE_ME

FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000

# Primeiro utilizador ADMIN_RH, criado automaticamente ao arrancar o backend.
ADMIN_EMAIL=admin@empresa.pt
ADMIN_PASSWORD=CHANGE_ME_min_8_chars
